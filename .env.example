# Set your own router URL. This reserved example domain is not a real router.
ROUTER_BASE_URL=https://router.example.invalid
# Factory credentials observed on this firmware; replace if changed.
ROUTER_USERNAME=user
ROUTER_PASSWORD=user
# For a self-signed router, independently verify and set its certificate pin.
# Never copy another installation's certificate fingerprint.
# ROUTER_TLS_SHA256=<64 hexadecimal digits>
ROUTER_ALLOW_WRITES=false
ROUTER_ALLOW_DANGEROUS_ACTIONS=false
